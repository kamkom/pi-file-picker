{
	"name": "pi-file-picker",
	"version": "0.1.0",
	"description": "A prettier @ file picker for the pi coding agent: Nerd Font icons, colors, match highlights and git status",
	"type": "module",
	"author": "kamilkompala",
	"keywords": [
		"pi-package",
		"pi-extension",
		"file-picker",
		"autocomplete",
		"nerd-fonts",
		"icons"
	],
	"files": [
		"src",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"check": "tsc --noEmit",
		"test": "vitest --run",
		"preview": "node --experimental-strip-types scripts/preview.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.3.0",
		"@earendil-works/pi-tui": "^1.3.0",
		"@types/node": "^22.20.5",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12"
	}
}
